# Sao chép thành .env rồi đổi giá trị. File .env KHÔNG commit.
# Sinh khoá: openssl rand -base64 48
JWT_SECRET=doi-gia-tri-nay-truoc-khi-deploy
ACCESS_TTL=15m
REFRESH_TTL=720h
ENV=dev
# Chỉ cần đặt khi chạy backend ngoài Docker Compose, ví dụ trên Vercel.
# Production nên dùng Supabase transaction pooler port 6543 và sslmode=require.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Origin được phép gọi API từ trình duyệt, phân tách bằng dấu phẩy. Để trống
# khi frontend đi qua proxy của Vite (dev) hoặc cùng domain với API (prod).
CORS_ORIGINS=

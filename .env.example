# Sao chép thành .env rồi đổi giá trị. File .env KHÔNG commit.
# Sinh khoá: openssl rand -base64 48
JWT_SECRET=doi-gia-tri-nay-truoc-khi-deploy
ACCESS_TTL=15m
REFRESH_TTL=720h
ENV=dev
# Chỉ cần đặt khi chạy backend ngoài Docker Compose, ví dụ trên Vercel.
# Production nên dùng Supabase transaction pooler port 6543 và sslmode=require.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Origin được phép gọi API từ trình duyệt, phân tách bằng dấu phẩy. Để trống
# khi frontend đi qua proxy của Vite (dev) hoặc cùng domain với API (prod).
CORS_ORIGINS=

# Vercel Cron gửi "Authorization: Bearer <CRON_SECRET>" khi gọi /api/cron/replay-bars
# (kéo nến NQ / ES từ TradingView và lưu vào DB mỗi tuần). Bỏ trống thì không gắn route cron.
# Sinh bằng: openssl rand -base64 32
# CRON_SECRET=

# Thư hệ thống và xác minh email (K-56).
# - Có RESEND_API_KEY: gửi thật qua Resend, bật xác minh email (ân hạn 7 ngày).
# - Dev không có key: thư chỉ in ra log của API (link xác minh nằm trong log).
# - Đã deploy (ENV=prod hoặc Vercel) mà không có key: TẮT xác minh, không chặn ai.
# Có key trên prod thì bắt buộc APP_URL và MAIL_FROM (domain đã xác minh ở Resend).
# RESEND_API_KEY=
# MAIL_FROM=Trading journal <no-reply@your-domain.com>
# APP_URL=https://your-domain.com
